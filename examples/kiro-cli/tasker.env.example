# Secretos para la ejecución en vivo de Tasker.
# Copiar a $dkco/kiro-cli/tasker.env, rellenar y `chmod 600`.
# El wrapper `kiro` los inyecta con --env-file (NO hardcodear en el mcp.json).

# IP del teléfono que corre Tasker (en tu LAN). CAMBIAR.
TASKER_HOST=CAMBIAR_IP_DEL_TELEFONO

# Puerto del server HTTP de Tasker (por defecto 1821).
TASKER_PORT=1821

# API key de Tasker (formato tk_...). La genera la tarea "MCP generate_api_key". CAMBIAR.
TASKER_API_KEY=CAMBIAR_tk_xxxxxxxx
